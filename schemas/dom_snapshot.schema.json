{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOM Snapshot",
  "description": "Sanitized DOM snapshot extracted by Dev 2's content script. Consumed by Dev 5 (LLM Planner).",
  "type": "object",
  "required": ["url", "title", "viewport", "elements"],
  "properties": {
    "url": { "type": "string", "description": "Current page URL" },
    "title": { "type": "string", "description": "Page title" },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "scroll_x": { "type": "integer", "default": 0 },
        "scroll_y": { "type": "integer", "default": 0 }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tag", "selector", "interactive"],
        "properties": {
          "id": { "type": "string", "description": "Unique element ID (e.g. e_search)" },
          "tag": { "type": "string", "description": "HTML tag name" },
          "selector": { "type": "string", "description": "CSS selector" },
          "type": { "type": ["string", "null"], "description": "Input type (text, submit, etc.)" },
          "interactive": { "type": "boolean", "description": "Whether element is clickable/interactive" },
          "role": { "type": ["string", "null"], "description": "ARIA role" },
          "text": { "type": ["string", "null"], "description": "Redacted text content ([TOKEN] placeholders)" },
          "placeholder": { "type": ["string", "null"] },
          "value": { "type": ["string", "null"], "description": "Redacted value ([TOKEN] placeholders)" },
          "coordinates": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height]"
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
