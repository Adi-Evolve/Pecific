{
  "$id": "vision_context.schema.json",
  "type": "object",
  "required": ["screen_type", "confidence", "faces_detected", "pii_regions", "backend", "processing_ms"],
  "properties": {
    "screen_type": {
      "type": "string",
      "pattern": "^(search_results|product_page|checkout|login_page|cart|form|unknown|model_class_[0-9]+)$"
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "confidence_basis": {
      "type": "string",
      "enum": ["mobilevit_image_class", "screen_class"]
    },
    "layout": {
      "type": "object",
      "properties": {
        "visual_density": { "type": "string", "enum": ["low", "medium", "high"] },
        "has_active_modal": { "type": "boolean" },
        "has_sticky_footer": { "type": "boolean" },
        "canvas_heavy": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "detected_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "bbox"],
        "properties": {
          "type": { "type": "string" },
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "faces_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox", "confidence"],
        "properties": {
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "pii_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "bbox"],
        "properties": {
          "type": { "type": "string", "enum": ["face", "text_pii"] },
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "visual_pii_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "bbox"],
        "properties": {
          "type": { "type": "string" },
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "backend": { "type": "string", "enum": ["webgpu", "wasm"] },
    "processing_ms": { "type": "number" },
    "predicted_class": { "type": "integer", "minimum": 0 },
    "model_output": { "type": "array", "items": { "type": "number" } }
  },
  "additionalProperties": false
}
