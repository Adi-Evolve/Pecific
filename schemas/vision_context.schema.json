{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vision Context",
  "description": "Merged BlazeFace + MobileViT output from Dev 4's vision worker. Consumed by Dev 5 (planner) and Dev 6 (VLM server).",
  "type": "object",
  "required": ["screen_type", "confidence"],
  "properties": {
    "screen_type": {
      "type": "string",
      "enum": [
        "search_results", "product_page", "login_page", "checkout",
        "form_page", "dashboard", "home_page", "category_page",
        "cart", "payment_page", "captcha", "unknown"
      ],
      "description": "MobileViT screen classification"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Classification confidence"
    },
    "faces_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height] — already blurred/redacted"
          },
          "confidence": { "type": "number" }
        }
      }
    },
    "pii_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["face", "text_pii"] },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "label": { "type": ["string", "null"] }
        }
      }
    }
  }
}
