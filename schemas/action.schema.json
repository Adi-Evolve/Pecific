{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActionStep",
  "description": "Structured execution command returned by Server LLM planner (R5) to Extension Content Script Action Executor (R2).",
  "type": "object",
  "required": ["id", "action"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Sequential step index in the plan (1-based)"
    },
    "action": {
      "type": "string",
      "enum": [
        "NAVIGATE", "CLICK", "TYPE", "TYPE_FROM_VAULT", "PRESS_KEY", "HOVER",
        "SCROLL", "SELECT", "WAIT", "SCREENSHOT", "EXTRACT", "NEW_TAB",
        "SWITCH_TAB", "CLOSE_TAB", "DISMISS_POPUP", "CAPTCHA_HANDOFF", "REPORT_RESULT"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "selector": { "type": "string" },
        "url": { "type": "string" },
        "coordinates": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "text": { "type": "string" },
        "tab_id": { "type": "integer" },
        "tab_purpose": { "type": "string" }
      }
    },
    "value": { "type": "string" },
    "key": { "type": "string" },
    "vault_key": { "type": "string" },
    "execution_mode": { "type": "string", "enum": ["DOM", "VISION", "HYBRID"], "default": "DOM" },
    "protocol_level": { "type": "string", "enum": ["SAFE", "CAUTION", "CRITICAL", "FORBIDDEN"], "default": "SAFE" },
    "description": { "type": "string" },
    "verify": {
      "type": "object",
      "required": ["method", "condition"],
      "properties": {
        "method": { "type": "string", "enum": ["DOM_CHECK", "URL_CHECK", "SCREENSHOT"] },
        "condition": { "type": "string" }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["action", "reason"],
      "properties": {
        "action": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "timeout_ms": { "type": "integer", "default": 5000 },
    "duration_ms": { "type": "integer" }
  }
}