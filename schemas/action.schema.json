{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Action Plan",
  "description": "Structured action plan generated by the LLM Server. Owned by Dev 5, consumed by Dev 2's action executor.",
  "type": "object",
  "required": ["session_id", "goal", "plan"],
  "properties": {
    "session_id": { "type": "string" },
    "goal": { "type": "string", "description": "Original user goal" },
    "plan": {
      "type": "object",
      "required": ["total_steps", "chain_of_thought", "steps"],
      "properties": {
        "total_steps": { "type": "integer", "minimum": 1 },
        "chain_of_thought": { "type": "string", "description": "Step-by-step reasoning" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/Step" },
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "Step": {
      "type": "object",
      "required": ["id", "action", "execution_mode", "protocol_level", "description", "verify"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "action": {
          "type": "string",
          "enum": [
            "NAVIGATE", "CLICK", "TYPE", "TYPE_FROM_VAULT", "SCROLL",
            "SELECT", "WAIT", "SCREENSHOT", "EXTRACT", "NEW_TAB",
            "SWITCH_TAB", "CLOSE_TAB", "DISMISS_POPUP", "CAPTCHA_HANDOFF",
            "PRESS_KEY", "REPORT_RESULT"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "selector": { "type": ["string", "null"] },
            "element_id": { "type": ["string", "null"] },
            "coordinates": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "url": { "type": ["string", "null"] },
            "tab_purpose": { "type": ["string", "null"] }
          }
        },
        "value": { "type": ["string", "null"], "description": "Text to type (for TYPE action)" },
        "vault_key": { "type": ["string", "null"], "description": "Vault field name (for TYPE_FROM_VAULT)" },
        "key": { "type": ["string", "null"], "description": "Key to press (for PRESS_KEY)" },
        "extraction_type": { "type": ["string", "null"], "enum": ["FIRST", "ALL", null] },
        "selectors": {
          "type": ["object", "null"],
          "description": "Sub-selectors for EXTRACT action"
        },
        "execution_mode": {
          "type": "string",
          "enum": ["DOM", "VISION", "HYBRID"]
        },
        "protocol_level": {
          "type": "string",
          "enum": ["SAFE", "CAUTION", "CRITICAL", "FORBIDDEN"]
        },
        "description": { "type": "string" },
        "verify": {
          "type": "object",
          "required": ["method", "condition"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["DOM_CHECK", "URL_CHECK", "SCREENSHOT", "VALUE_MATCH"]
            },
            "condition": { "type": "string" }
          }
        },
        "fallback": {
          "type": "object",
          "properties": {
            "action": { "type": "string" },
            "reason": { "type": "string" }
          }
        },
        "timeout_ms": { "type": "integer", "default": 5000 }
      }
    }
  }
}
